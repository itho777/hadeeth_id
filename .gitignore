# Per-Hadith individual JSON files (served from GitHub Pages / Cloudflare Pages)
# data/hadiths/ is intentionally tracked to act as a blazing-fast static CDN

# Large binary files (too large for GitHub)
data/sqlite/
supabase/seed.sql
supabase/seeds/

# Python cache
__pycache__/
*.pyc
*.pyo

# Temp files
*.tmp
~$*

# Node modules
node_modules/

# Environment secrets
.env

# Windows thumbnail cache
Thumbs.db
Desktop.ini

# Scratch files
scratch/
