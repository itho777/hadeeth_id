# ===========================================================================
# hadeeth.id — repository ignore rules
# ===========================================================================
# Principle: commit SOURCE and FINAL RESULTS. Never commit process output.
# That means no logs, no probe scripts, no scratch dumps, no local databases,
# no regenerable multi-megabyte intermediates.
#
# NOTE: data/hadiths/ and data/commentaries/ and data/rawis/profiles/ ARE
# tracked on purpose — they are the per-hadith JSON the CDN serves.
# ===========================================================================

# --- Environment secrets ---------------------------------------------------
.env
.env.*
!.env.example

# --- Python / Node ---------------------------------------------------------
__pycache__/
*.pyc
*.pyo
node_modules/

# --- OS cruft --------------------------------------------------------------
Thumbs.db
Desktop.ini
~$*
*.tmp
*.swp

# --- Local databases and dumps --------------------------------------------
# Rebuilt from source files; never source of truth.
*.db
*.db-wal
*.db-shm
data/sqlite/
data/supabase/
data/supabase_search.csv
supabase/seed.sql
supabase/seeds/
data/backup/
data/exports/
data/datasets/

# --- Vendored source archives (large, re-downloadable) --------------------
# NOTE: fawaz_combined_v2 and fawaz_repo already contain tracked files, so they
# are deliberately NOT ignored here — ignoring them would be misleading.
data/sources/fawaz_api/
data/sources/usm_grading/
data/fawaz_combined/

# --- Mapping artifacts ----------------------------------------------------
# Per-collection link files are ~38 MB and fully regenerated by:
#   map_collection.py / enrich_collection.py / build_mapping.py
# The published summary the site reads is data/mapping-stats.json, which is
# intentionally tracked.
# Root-anchored on purpose: data/lidwa_extracts/mapping_*.json is LIDWA SOURCE
# DATA and must stay tracked.
/*_links.json
/mapping_*.json
/*_full.json
/nawawi_links_raw.json
/fawaz_number_map.json
/fawaz_verified_joins.json

# --- Process output: logs, probes, ad-hoc dumps ---------------------------
*.log
/_*.py
/data_scan.log
/cf_deploy.log
/cf_pages.log
/ch_out.json
/query_out.json
/naw_d1.json
/conversation_history.jsonl
diff_read_more.txt
*.bak
*.bak-*
scratch/
tmp/
tmp_pages_deploy/

# --- Project-internal notes, not site content -----------------------------
SCHEME_DISPLAY.md
export/

# D1 dump + local sqlite (regenerated by scripts/load_d1_dump.py)
.dump/
export/

# Cloudflare token dropped by wrangler / manual login
.cf_token
.wrangler/

# Search pre-index shards (391 MB of regenerable NDJSON; source of truth is R2)
# scripts/build_preindex.py rebuilds them from export_site/api and the bucket.
export_site/search/
