[], "syarah_ar": "", "syarah_en": "", "syarah_id": "", "syarah_source": "", "related": [], "grade_en": "", "grade_id": "", "lidwa_id": null, "grade": ""}, {"id": "25", "hadith_number": "25", "chapter_id": "0", "text_ar": "لَا شَکَرَ اللهَ مَنْ لَّا یَشْکُرُ النَّاسَ", "text_ar_plain": "لا شکر الله من لا یشکر الناس", "text_en": "He does not thank Allah who does not thank people.", "text_id": "", "text_ur": "", "rawis": [], "paths": [], "syarah_ar": "", "syarah_en": "", "syarah_id": "", "syarah_source": "", "related": [], "grade_en": "", "grade_id": "", "lidwa_id": null, "grade": ""}, {"id": "26", "hadith_number": "26", "chapter_id": "0", "text_ar": "حُبُّكَ الشَّيْءَ یُعْمِيْ وَ یُصِمُّ", "text_ar_plain": "حبك الشيء یعمي و یصم", "text_en": "Your love of something can blind and deafen (you).", "text_id": "", "text_ur": "", "rawis": [], "paths": [], "syarah_ar": "", "syarah_en": "", "syarah_id": "", "syarah_source": "", "related": [], "grade_en": "", "grade_id": "", "lidwa_id": null, "grade": ""}, {"id": "27", "hadith_number": "27", "chapter_id": "0", "text_ar": "جُبِلَتِ الْقُلُوبُ عَلی حُبَّ مَنْ اَحْسَنَ اِلَیْهَا وَ بُغْضِ مَنْ اَسَاءَ اِلَیْهَا", "text_ar_plain": "جبلت القلوب علی حب من احسن الیها و بغض من اساء الیها", "text_en": "Hearts are predisposed to love someone who does them good and detest someone who does them harm.", "text_id": "", "text_ur": "", "rawis": [], "paths": [], "syarah_ar": "", "syarah_en": "", "syarah_id": "", "syarah_source": "", "related": [], "grade_en": "", "grade_id": "", "lidwa_id": null, "grade": ""}, {"id": "28", "hadith_number": "28", "chapter_id": "0", "text_ar": "الْتَّائِبُ مِنَ الذَّنْبِ کَمَنْ لَا ذَنْبَ لَهُ", "text_ar_plain": "التائب من الذنب کمن لا ذنب له", "text_en": "One who repents from sin is like someone without sin.", "text_id": "", "text_ur": "", "rawis": [], "paths": [], "syarah_ar": "", "syarah_en": "", "syarah_id": "", "syarah_source": "", "related": [], "grade_en": "", "grade_id": "", "lidwa_id": null, "grade": ""}, {"id": "29", "hadith_number": "29", "chapter_id": "0", "text_ar": "الشَّاهِدُ یَرَی مَا لَا یَرَاهُ الْغَائِبُ", "text_ar_plain": "الشاهد یری ما لا یراه الغائب", "text_en": "The person who actually witnesses an (event) sees that which one who is absent does not.", "text_id": "", "text_ur": "", "rawis": [], "paths": [], "syarah_ar": "", "syarah_en": "", "syarah_id": "", "syarah_source": "", "related": [], "grade_en": "", "grade_id": "", "lidwa_id": null, "grade": ""}, {"id": "30", "hadith_number": "30", "chapter_id": "0", "text_ar": "اِذا جَاءَکُمْ کَرِیْمُ قَوْمٍ فَاَکْرِمُوهُ", "text_ar_plain": "اذا جاءکم کریم قوم فاکرموه", "text_en": "If the nobleman of a people comes to you, honour him.", "text_id": "", "text_ur": "", "rawis": [], "paths": [], "syarah_ar": "", "syarah_en": "", "syarah_id": "", "syarah_source": "", "related": [], "grade_en": "", "grade_id": "", "lidwa_id": null, "grade": ""}, {"id": "31", "hadith_number": "31", "chapter_id": "0", "text_ar": "الْیَمِینُ الْفَاجِرَةُ تَدَعُ الدِّیَارَ الْبَلَاقِعَ", "text_ar_plain": "الیمین الفاجرة تدع الدیار البلاقع", "text_en": "False oaths lay waste to home (lands).", "text_id": "", "text_ur": "", "rawis": [], "paths": [], "syarah_ar": "", "syarah_en": "", "syarah_id": "", "syarah_source": "", "related": [], "grade_en": "", "grade_id": "", "lidwa_id": null, "grade": ""}, {"id": "32", "hadith_number": "32", "chapter_id": "0", "text_ar": "مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ شَهِیْدٌ", "text_ar_plain": "من قتل دون ماله فهو شهید", "text_en": "Whoever is killed attempting to save his property is a martyr.", "text_id": "", "text_ur": "", "rawis": [], "paths": [], "syarah_ar": "", "syarah_en": "", "syarah_id": "", "syarah_source": "", "related": [], "grade_en": "", "grade_id": "", "lidwa_id": null, "grade": ""}, {"id": "33", "hadith_number": "33", "chapter_id": "0", "text_ar": "الْاَعْمَالُ بِالنِّیَّةِ", "text_ar_plain": "الاعمال بالنیة", "text_en": "Actions are through intentions.", "text_id": "", "text_ur": "", "rawis